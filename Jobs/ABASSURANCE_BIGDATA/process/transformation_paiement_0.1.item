  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="576" posY="192">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="Object rawAb = globalMap.get(&quot;tJavaRow_1_NB_LINE&quot;);&#xA;Object rawAp = globalMap.get(&quot;tJavaRow_2_NB_LINE&quot;);&#xA;&#xA;if (rawAb == null) {&#xA;    System.err.println(&quot;ATTENTION : cle tJavaRow_1_NB_LINE introuvable dans globalMap&quot;);&#xA;}&#xA;if (rawAp == null) {&#xA;    System.err.println(&quot;ATTENTION : cle tJavaRow_2_NB_LINE introuvable dans globalMap&quot;);&#xA;}&#xA;&#xA;int nbLignesAb = (rawAb != null) ? (Integer) rawAb : 0;&#xA;int nbLignesAp = (rawAp != null) ? (Integer) rawAp : 0;&#xA;int nbLignesFinales = nbLignesAp;&#xA;int nbDoublonsFusionnes = 0;&#xA;&#xA;String dateExecution = new java.text.SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(new java.util.Date());&#xA;String ligneJournal = dateExecution + &quot;,CONTRAT,&quot; + nbLignesAb + &quot;,&quot; + nbLignesAp + &quot;,&quot;&#xA;    + nbLignesFinales + &quot;,&quot; + nbDoublonsFusionnes;&#xA;&#xA;String cheminJournal = &quot;C:/xampp/htdocs/projets/abassurance-bigdata/data/logs/journal_transformation.csv&quot;;&#xA;java.io.File fichierJournal = new java.io.File(cheminJournal);&#xA;boolean fichierExisteDeja = fichierJournal.exists();&#xA;fichierJournal.getParentFile().mkdirs();&#xA;&#xA;try (java.io.FileWriter writer = new java.io.FileWriter(fichierJournal, true)) {&#xA;    if (!fichierExisteDeja) {&#xA;        writer.write(&quot;date_execution,table_cible,nb_lignes_ab,nb_lignes_ap,nb_lignes_finales,nb_doublons_fusionnes\n&quot;);&#xA;    }&#xA;    writer.write(ligneJournal + &quot;\n&quot;);&#xA;    System.out.println(&quot;Journal de transformation mis a jour : &quot; + ligneJournal);&#xA;} catch (java.io.IOException e) {&#xA;    System.err.println(&quot;Erreur ecriture journal : &quot; + e.getMessage());&#xA;}"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>

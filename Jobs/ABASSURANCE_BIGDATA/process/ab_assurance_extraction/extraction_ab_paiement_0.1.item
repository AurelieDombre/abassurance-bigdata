  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="416" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="// Récupération des deux compteurs automatiques de Talend&#xA;// (imagine ça comme deux compteurs de personnes à l'entrée et à la sortie d'une salle :&#xA;// s'ils affichent le même chiffre, personne ne s'est perdu en chemin)&#xA;int nbLignesSource = (Integer) globalMap.get(&quot;tFileInputDelimited_2_NB_LINE&quot;);&#xA;int nbLignesExtrait = (Integer) globalMap.get(&quot;tFileOutputDelimited_1_NB_LINE&quot;);&#xA;&#xA;int ecart = nbLignesExtrait - nbLignesSource;&#xA;String statut = (ecart == 0) ? &quot;OK&quot; : &quot;KO&quot;;&#xA;&#xA;// Nom du système et de la table à adapter pour chaque job&#xA;// (les seules 2 lignes à changer quand tu copies ce tJava d'un job à l'autre)&#xA;String systeme = &quot;AbAssurance&quot;;&#xA;String table = &quot;AB_PAIEMENT&quot;;&#xA;&#xA;// Construction de la ligne à écrire dans le journal&#xA;String dateExecution = new java.text.SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(new java.util.Date());&#xA;String ligneJournal = dateExecution + &quot;,&quot; + systeme + &quot;,&quot; + table + &quot;,&quot; &#xA;    + nbLignesSource + &quot;,&quot; + nbLignesExtrait + &quot;,&quot; + ecart + &quot;,&quot; + statut;&#xA;&#xA;// Chemin du fichier journal partagé entre tous les jobs&#xA;String cheminJournal = &quot;C:/xampp/htdocs/projets/abassurance-bigdata/data/logs/controle_extraction.csv&quot;;&#xA;java.io.File fichierJournal = new java.io.File(cheminJournal);&#xA;&#xA;// Si le fichier n'existe pas encore, on crée le dossier parent et on écrit l'en-tête d'abord&#xA;boolean fichierExisteDeja = fichierJournal.exists();&#xA;fichierJournal.getParentFile().mkdirs();&#xA;&#xA;try (java.io.FileWriter writer = new java.io.FileWriter(fichierJournal, true)) { // true = mode Append&#xA;    if (!fichierExisteDeja) {&#xA;        writer.write(&quot;date_execution,systeme_source,table,nb_lignes_source,nb_lignes_extraites,ecart,statut\n&quot;);&#xA;    }&#xA;    writer.write(ligneJournal + &quot;\n&quot;);&#xA;    System.out.println(&quot;Journal mis a jour : &quot; + ligneJournal);&#xA;} catch (java.io.IOException e) {&#xA;    System.err.println(&quot;Erreur ecriture journal : &quot; + e.getMessage());&#xA;}"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
  <connection connectorName="FLOW" label="row1" lineStyle="0" metaname="tFileInputDelimited_2" offsetLabelX="0" offsetLabelY="0" source="tFileInputDelimited_2" target="tFileOutputDelimited_1">

  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="224" posY="224">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_2" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="// Identifiant unifié préfixé pour éviter toute collision avec AssurePlus&#xA;// (ex: AB-1, AB-2... alors que AssurePlus utilisera AP-1, AP-2...)&#xA;// AP_USERS&#xA;output_row.client_id = &quot;AP-&quot; + input_row.ap_user_id;&#xA;&#xA;// Fusion nom + prénom en un seul champ, pour matcher la structure&#xA;// d'AssurePlus qui n'a qu'un ap_full_name unique&#xA;output_row.nom_prenom = input_row.ap_full_name;&#xA;output_row.date_naissance = input_row.ap_birth_date;&#xA;output_row.email = input_row.ap_mail_address;&#xA;output_row.telephone = input_row.ap_phone_number;&#xA;output_row.adresse = input_row.ap_street_address;&#xA;output_row.code_postal = input_row.ap_zip_code;&#xA;output_row.num_fiscal = null; // n'existe pas côté AssurePlus&#xA;output_row.date_creation = input_row.ap_created_at;&#xA;output_row.statut_client = input_row.ap_customer_status;&#xA;output_row.loyalty_score = input_row.ap_loyalty_score;&#xA;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_2">

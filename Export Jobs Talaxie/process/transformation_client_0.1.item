    <elementParameter field="MEMO_JAVA" name="CODE" value="// Identifiant unifié préfixé pour éviter toute collision avec AssurePlus&#xA;// (ex: AB-1, AB-2... alors que AssurePlus utilisera AP-1, AP-2...)&#xA;output_row.client_id = &quot;AB-&quot; + input_row.AB_CLIENT_ID;&#xA;&#xA;output_row.nom_prenom = input_row.AB_NOM + &quot;_&quot; + input_row.AB_PRENOM;&#xA;output_row.date_naissance = input_row.AB_DATE_NAISSANCE;&#xA;output_row.email = input_row.AB_EMAIL;&#xA;output_row.telephone = input_row.AB_TELEPHONE;&#xA;output_row.adresse = input_row.AB_ADRESSE;&#xA;output_row.code_postal = input_row.AB_CODE_POSTAL;&#xA;output_row.num_fiscal = input_row.AB_NUM_FISCAL;&#xA;output_row.date_creation = input_row.AB_DATE_CREATION;&#xA;output_row.statut_client = input_row.AB_STATUT_CLIENT;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>

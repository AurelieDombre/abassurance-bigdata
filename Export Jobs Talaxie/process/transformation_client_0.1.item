  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="704" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="// Récupération des compteurs automatiques générés par chaque composant&#xA;int nbLignesAb = (Integer) globalMap.get(&quot;tJavaRow_1_NB_LINE&quot;);       // sortie du tJavaRow AB_CLIENT&#xA;int nbLignesAp = (Integer) globalMap.get(&quot;tJavaRow_2_NB_LINE&quot;);       // sortie du tJavaRow AP_USERS&#xA;int nbLignesFinales = (Integer) globalMap.get(&quot;tUniqRow_1_NB_UNIQUES&quot;); // ligne &quot;Uniques&quot; du tUniqRow&#xA;int nbDoublonsFusionnes = (Integer) globalMap.get(&quot;tUniqRow_1_NB_DUPLICATES&quot;); // ligne &quot;Doublons&quot;&#xA;&#xA;String dateExecution = new java.text.SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(new java.util.Date());&#xA;String ligneJournal = dateExecution + &quot;,CLIENT,&quot; + nbLignesAb + &quot;,&quot; + nbLignesAp + &quot;,&quot;&#xA;    + nbLignesFinales + &quot;,&quot; + nbDoublonsFusionnes;&#xA;&#xA;String cheminJournal = &quot;C:/xampp/htdocs/projets/abassurance-bigdata/data/logs/journal_transformation.csv&quot;;&#xA;java.io.File fichierJournal = new java.io.File(cheminJournal);&#xA;boolean fichierExisteDeja = fichierJournal.exists();&#xA;fichierJournal.getParentFile().mkdirs();&#xA;&#xA;try (java.io.FileWriter writer = new java.io.FileWriter(fichierJournal, true)) {&#xA;    if (!fichierExisteDeja) {&#xA;        writer.write(&quot;date_execution,table_cible,nb_lignes_ab,nb_lignes_ap,nb_lignes_finales,nb_doublons_fusionnes\n&quot;);&#xA;    }&#xA;    writer.write(ligneJournal + &quot;\n&quot;);&#xA;    System.out.println(&quot;Journal de transformation mis a jour : &quot; + ligneJournal);&#xA;} catch (java.io.IOException e) {&#xA;    System.err.println(&quot;Erreur ecriture journal : &quot; + e.getMessage());&#xA;}"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>

  <node componentName="tJavaFlex" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="288" posY="128">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaFlex_1" show="false"/>
    <elementParameter field="CHECK" name="DATA_AUTO_PROPAGATE" value="true"/>
    <elementParameter field="MEMO_JAVA" name="CODE_START" value="// ============================================================&#xA;// CREATION DU PRODUCER KAFKA&#xA;// ============================================================&#xA;&#xA;java.util.Properties kafkaProps = new java.util.Properties();&#xA;&#xA;kafkaProps.put(&#xA;    org.apache.kafka.clients.producer.ProducerConfig.BOOTSTRAP_SERVERS_CONFIG,&#xA;    &quot;localhost:9092&quot;&#xA;);&#xA;&#xA;kafkaProps.put(&#xA;    org.apache.kafka.clients.producer.ProducerConfig.KEY_SERIALIZER_CLASS_CONFIG,&#xA;    &quot;org.apache.kafka.common.serialization.StringSerializer&quot;&#xA;);&#xA;&#xA;kafkaProps.put(&#xA;    org.apache.kafka.clients.producer.ProducerConfig.VALUE_SERIALIZER_CLASS_CONFIG,&#xA;    &quot;org.apache.kafka.common.serialization.StringSerializer&quot;&#xA;);&#xA;&#xA;org.apache.kafka.clients.producer.KafkaProducer&lt;String, String> kafkaProducer =&#xA;    new org.apache.kafka.clients.producer.KafkaProducer&lt;>(kafkaProps);&#xA;&#xA;&#xA;// ============================================================&#xA;// COMPTEURS&#xA;// ============================================================&#xA;&#xA;java.util.concurrent.atomic.AtomicInteger compteurEnvoisTentes =&#xA;    new java.util.concurrent.atomic.AtomicInteger(0);&#xA;&#xA;java.util.concurrent.atomic.AtomicInteger compteurEnvoisReussis =&#xA;    new java.util.concurrent.atomic.AtomicInteger(0);&#xA;&#xA;java.util.concurrent.atomic.AtomicInteger compteurEnvoisEchoues =&#xA;    new java.util.concurrent.atomic.AtomicInteger(0);&#xA;&#xA;&#xA;// ============================================================&#xA;// METHODE POUR ECHAPPER LES CARACTERES SPECIAUX JSON&#xA;// ============================================================&#xA;&#xA;java.util.function.Function&lt;String, String> echapperJson = (valeur) -> {&#xA;&#xA;    if (valeur == null) {&#xA;        return &quot;&quot;;&#xA;    }&#xA;&#xA;    return valeur&#xA;        .replace(&quot;\\&quot;, &quot;\\\\&quot;)&#xA;        .replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;)&#xA;        .replace(&quot;\n&quot;, &quot;\\n&quot;)&#xA;        .replace(&quot;\r&quot;, &quot;\\r&quot;);&#xA;};"/>
    <elementParameter field="MEMO_JAVA" name="CODE_MAIN" value="// ============================================================&#xA;// 1. NORMALISATION DU STATUT DU CONTRAT&#xA;// ============================================================&#xA;&#xA;String statutContrat = row1.statut_contrat;&#xA;&#xA;if (statutContrat != null) {&#xA;&#xA;    statutContrat = statutContrat.trim().toUpperCase();&#xA;&#xA;    if (&quot;ACTIVE&quot;.equals(statutContrat)) {&#xA;&#xA;        statutContrat = &quot;ACTIF&quot;;&#xA;&#xA;    } else if (&quot;SUSPENDED&quot;.equals(statutContrat)) {&#xA;&#xA;        statutContrat = &quot;SUSPENDU&quot;;&#xA;&#xA;    } else if (&quot;TERMINATED&quot;.equals(statutContrat)) {&#xA;&#xA;        statutContrat = &quot;RESILIE&quot;;&#xA;    }&#xA;}&#xA;&#xA;&#xA;// ============================================================&#xA;// 2. NORMALISATION DES PRIMES&#xA;// ============================================================&#xA;&#xA;// Si la prime annuelle est absente, on met 0&#xA;String primeAnnuelle =&#xA;    (row1.prime_annuelle != null &amp;&amp; !row1.prime_annuelle.trim().isEmpty())&#xA;        ? row1.prime_annuelle&#xA;        : &quot;0&quot;;&#xA;&#xA;// Si la prime mensuelle est absente, on met 0&#xA;String primeMensuelle =&#xA;    (row1.prime_mensuelle != null &amp;&amp; !row1.prime_mensuelle.trim().isEmpty())&#xA;        ? row1.prime_mensuelle&#xA;        : &quot;0&quot;;&#xA;&#xA;&#xA;// ============================================================&#xA;// 3. CONSTRUCTION DU MESSAGE JSON&#xA;// ============================================================&#xA;&#xA;String messageJson = &quot;{&quot;&#xA;&#xA;    + &quot;\&quot;contrat_id\&quot;:\&quot;&quot;&#xA;    + echapperJson.apply(row1.contrat_id)&#xA;    + &quot;\&quot;,&quot;&#xA;&#xA;    + &quot;\&quot;client_id\&quot;:\&quot;&quot;&#xA;    + echapperJson.apply(row1.client_id)&#xA;    + &quot;\&quot;,&quot;&#xA;&#xA;    + &quot;\&quot;type_assurance\&quot;:\&quot;&quot;&#xA;    + echapperJson.apply(row1.type_assurance)&#xA;    + &quot;\&quot;,&quot;&#xA;&#xA;    + &quot;\&quot;code_produit\&quot;:\&quot;&quot;&#xA;    + echapperJson.apply(row1.code_produit)&#xA;    + &quot;\&quot;,&quot;&#xA;&#xA;    + &quot;\&quot;date_debut\&quot;:\&quot;&quot;&#xA;    + echapperJson.apply(row1.date_debut)&#xA;    + &quot;\&quot;,&quot;&#xA;&#xA;    + &quot;\&quot;date_fin\&quot;:\&quot;&quot;&#xA;    + echapperJson.apply(row1.date_fin)&#xA;    + &quot;\&quot;,&quot;&#xA;&#xA;    // Prime annuelle : 0 si absente&#xA;    + &quot;\&quot;prime_annuelle\&quot;:&quot;&#xA;    + primeAnnuelle&#xA;    + &quot;,&quot;&#xA;&#xA;    // Prime mensuelle : 0 si absente&#xA;    + &quot;\&quot;prime_mensuelle\&quot;:&quot;&#xA;    + primeMensuelle&#xA;    + &quot;,&quot;&#xA;&#xA;    // Statut du contrat normalisé en français&#xA;    + &quot;\&quot;statut_contrat\&quot;:\&quot;&quot;&#xA;    + echapperJson.apply(statutContrat)&#xA;    + &quot;\&quot;,&quot;&#xA;&#xA;    + &quot;\&quot;agence_id\&quot;:\&quot;&quot;&#xA;    + echapperJson.apply(row1.agence_id)&#xA;    + &quot;\&quot;,&quot;&#xA;&#xA;    + &quot;\&quot;code_courtier\&quot;:\&quot;&quot;&#xA;    + echapperJson.apply(row1.code_courtier)&#xA;    + &quot;\&quot;&quot;&#xA;&#xA;    + &quot;}&quot;;&#xA;&#xA;&#xA;// ============================================================&#xA;// 4. CREATION DU MESSAGE KAFKA&#xA;// ============================================================&#xA;&#xA;org.apache.kafka.clients.producer.ProducerRecord&lt;String, String> recordKafka =&#xA;    new org.apache.kafka.clients.producer.ProducerRecord&lt;>(&#xA;        &quot;abassurance.contrats.v1&quot;,&#xA;        row1.contrat_id,&#xA;        messageJson&#xA;    );&#xA;&#xA;&#xA;// ============================================================&#xA;// 5. COMPTEUR DES ENVOIS&#xA;// ============================================================&#xA;&#xA;compteurEnvoisTentes.incrementAndGet();&#xA;&#xA;final String contratIdPourLog = row1.contrat_id;&#xA;&#xA;&#xA;// ============================================================&#xA;// 6. ENVOI VERS KAFKA&#xA;// ============================================================&#xA;&#xA;kafkaProducer.send(recordKafka, (metadata, exception) -> {&#xA;&#xA;    if (exception == null) {&#xA;&#xA;        compteurEnvoisReussis.incrementAndGet();&#xA;&#xA;    } else {&#xA;&#xA;        compteurEnvoisEchoues.incrementAndGet();&#xA;&#xA;        System.err.println(&#xA;            &quot;Echec envoi Kafka pour contrat &quot;&#xA;            + contratIdPourLog&#xA;            + &quot; : &quot;&#xA;            + exception.getMessage()&#xA;        );&#xA;    }&#xA;});&#xA;&#xA;&#xA;// ============================================================&#xA;// 7. TRANSMISSION VERS LA SUITE DU JOB&#xA;// ============================================================&#xA;&#xA;row2.contrat_id = row1.contrat_id;&#xA;&#xA;row2.client_id = row1.client_id;&#xA;&#xA;row2.type_assurance = row1.type_assurance;&#xA;&#xA;row2.code_produit = row1.code_produit;&#xA;&#xA;row2.date_debut = row1.date_debut;&#xA;&#xA;row2.date_fin = row1.date_fin;&#xA;&#xA;// On transmet les primes normalisées&#xA;row2.prime_annuelle = primeAnnuelle;&#xA;&#xA;row2.prime_mensuelle = primeMensuelle;&#xA;&#xA;// On transmet le statut normalisé&#xA;row2.statut_contrat = statutContrat;&#xA;&#xA;row2.agence_id = row1.agence_id;&#xA;&#xA;row2.code_courtier = row1.code_courtier;"/>
    <elementParameter field="MEMO_JAVA" name="CODE_END" value="// flush() attend que TOUS les envois en attente soient partis avant de continuer&#xA;// (sinon avec close() direct, tu risques de perdre les derniers messages en vol)&#xA;kafkaProducer.flush();&#xA;kafkaProducer.close();&#xA;&#xA;globalMap.put(&quot;kafka_envois_tentes&quot;, compteurEnvoisTentes.get());&#xA;globalMap.put(&quot;kafka_envois_reussis&quot;, compteurEnvoisReussis.get());&#xA;globalMap.put(&quot;kafka_envois_echoues&quot;, compteurEnvoisEchoues.get());&#xA;&#xA;System.out.println(&quot;Kafka - Tentes: &quot; + compteurEnvoisTentes.get()&#xA;    + &quot; | Reussis: &quot; + compteurEnvoisReussis.get()&#xA;    + &quot; | Echoues: &quot; + compteurEnvoisEchoues.get());"/>
    <elementParameter field="CHECK" name="Version_V2_0" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V3_2" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V4.0" value="true" show="false"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>

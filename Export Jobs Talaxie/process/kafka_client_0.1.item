  <node componentName="tJavaFlex" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="352" posY="192">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaFlex_1" show="false"/>
    <elementParameter field="CHECK" name="DATA_AUTO_PROPAGATE" value="true"/>
    <elementParameter field="MEMO_JAVA" name="CODE_START" value="// ============================================================&#xA;// PRODUCTEUR KAFKA&#xA;// ============================================================&#xA;&#xA;java.util.Properties kafkaProps = new java.util.Properties();&#xA;&#xA;kafkaProps.put(&#xA;    org.apache.kafka.clients.producer.ProducerConfig.BOOTSTRAP_SERVERS_CONFIG,&#xA;    &quot;localhost:9092&quot;&#xA;);&#xA;&#xA;kafkaProps.put(&#xA;    org.apache.kafka.clients.producer.ProducerConfig.KEY_SERIALIZER_CLASS_CONFIG,&#xA;    &quot;org.apache.kafka.common.serialization.StringSerializer&quot;&#xA;);&#xA;&#xA;kafkaProps.put(&#xA;    org.apache.kafka.clients.producer.ProducerConfig.VALUE_SERIALIZER_CLASS_CONFIG,&#xA;    &quot;org.apache.kafka.common.serialization.StringSerializer&quot;&#xA;);&#xA;&#xA;org.apache.kafka.clients.producer.KafkaProducer&lt;String, String> kafkaProducer =&#xA;    new org.apache.kafka.clients.producer.KafkaProducer&lt;>(kafkaProps);&#xA;&#xA;&#xA;// ============================================================&#xA;// COMPTEURS&#xA;// ============================================================&#xA;&#xA;java.util.concurrent.atomic.AtomicInteger compteurEnvoisTentes =&#xA;    new java.util.concurrent.atomic.AtomicInteger(0);&#xA;&#xA;java.util.concurrent.atomic.AtomicInteger compteurEnvoisReussis =&#xA;    new java.util.concurrent.atomic.AtomicInteger(0);&#xA;&#xA;java.util.concurrent.atomic.AtomicInteger compteurEnvoisEchoues =&#xA;    new java.util.concurrent.atomic.AtomicInteger(0);&#xA;&#xA;System.out.println(&quot;==============================================&quot;);&#xA;System.out.println(&quot;Démarrage du producteur Kafka CLIENTS&quot;);&#xA;System.out.println(&quot;Topic : abassurance.clients.v1&quot;);&#xA;System.out.println(&quot;==============================================&quot;);"/>
    <elementParameter field="MEMO_JAVA" name="CODE_MAIN" value="// ============================================================&#xA;// 1. NORMALISATION DU TELEPHONE&#xA;// ============================================================&#xA;&#xA;String telephoneNormalise = null;&#xA;&#xA;if (row1.telephone != null) {&#xA;&#xA;    String telephone = row1.telephone.trim();&#xA;&#xA;    if (!telephone.isEmpty()) {&#xA;&#xA;        // ----------------------------------------------------&#xA;        // Cas : +33 (0)6 95 02 81 40&#xA;        // Devient : 06 95 02 81 40&#xA;        // ----------------------------------------------------&#xA;&#xA;        if (telephone.matches(&quot;^\\+33\\s*\\(0\\).*&quot;)) {&#xA;&#xA;            telephone = telephone.replaceFirst(&#xA;                &quot;^\\+33\\s*\\(0\\)&quot;,&#xA;                &quot;0&quot;&#xA;            );&#xA;        }&#xA;&#xA;        // ----------------------------------------------------&#xA;        // Cas : +33 6 95 02 81 40&#xA;        // Devient : 06 95 02 81 40&#xA;        // ----------------------------------------------------&#xA;&#xA;        else if (telephone.matches(&quot;^\\+33.*&quot;)) {&#xA;&#xA;            telephone = telephone.replaceFirst(&#xA;                &quot;^\\+33&quot;,&#xA;                &quot;0&quot;&#xA;            );&#xA;        }&#xA;&#xA;        // ----------------------------------------------------&#xA;        // Cas : 0033 6 95 02 81 40&#xA;        // Devient : 06 95 02 81 40&#xA;        // ----------------------------------------------------&#xA;&#xA;        else if (telephone.startsWith(&quot;0033&quot;)) {&#xA;&#xA;            telephone = telephone.replaceFirst(&#xA;                &quot;^0033&quot;,&#xA;                &quot;0&quot;&#xA;            );&#xA;        }&#xA;&#xA;        // ----------------------------------------------------&#xA;        // Suppression de tout ce qui n'est pas un chiffre&#xA;        // ----------------------------------------------------&#xA;&#xA;        telephone = telephone.replaceAll(&quot;[^0-9]&quot;, &quot;&quot;);&#xA;&#xA;        // ----------------------------------------------------&#xA;        // Vérification :&#xA;        // un numéro français doit avoir 10 chiffres&#xA;        // et commencer par 0&#xA;        // ----------------------------------------------------&#xA;&#xA;        if (telephone.length() == 10&#xA;                &amp;&amp; telephone.startsWith(&quot;0&quot;)) {&#xA;&#xA;            // ------------------------------------------------&#xA;            // Format final :&#xA;            // 0430235116&#xA;            // devient&#xA;            // 04 30 23 51 16&#xA;            // ------------------------------------------------&#xA;&#xA;            telephoneNormalise =&#xA;                telephone.replaceAll(&#xA;                    &quot;(\\d{2})(?=\\d)&quot;,&#xA;                    &quot;$1 &quot;&#xA;                ).trim();&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;&#xA;// ============================================================&#xA;// 2. NORMALISATION DU STATUT CLIENT&#xA;// ============================================================&#xA;&#xA;String statutNormalise = null;&#xA;&#xA;if (row1.statut_client != null) {&#xA;&#xA;    String statut = row1.statut_client.trim();&#xA;&#xA;    if (!statut.isEmpty()) {&#xA;&#xA;        // On travaille en majuscules pour comparer&#xA;        String statutMaj = statut.toUpperCase();&#xA;&#xA;        // ----------------------------------------------------&#xA;        // Anglais -> Français&#xA;        // ----------------------------------------------------&#xA;&#xA;        if (&quot;ACTIVE&quot;.equals(statutMaj)) {&#xA;&#xA;            statutNormalise = &quot;ACTIF&quot;;&#xA;&#xA;        } else if (&quot;INACTIVE&quot;.equals(statutMaj)) {&#xA;&#xA;            statutNormalise = &quot;INACTIF&quot;;&#xA;&#xA;        } else if (&quot;SUSPENDED&quot;.equals(statutMaj)) {&#xA;&#xA;            statutNormalise = &quot;SUSPENDU&quot;;&#xA;&#xA;        }&#xA;&#xA;        // ----------------------------------------------------&#xA;        // Valeurs déjà françaises&#xA;        // ----------------------------------------------------&#xA;&#xA;        else if (&quot;ACTIF&quot;.equals(statutMaj)) {&#xA;&#xA;            statutNormalise = &quot;ACTIF&quot;;&#xA;&#xA;        } else if (&quot;INACTIF&quot;.equals(statutMaj)) {&#xA;&#xA;            statutNormalise = &quot;INACTIF&quot;;&#xA;&#xA;        } else if (&quot;SUSPENDU&quot;.equals(statutMaj)) {&#xA;&#xA;            statutNormalise = &quot;SUSPENDU&quot;;&#xA;&#xA;        }&#xA;&#xA;        // ----------------------------------------------------&#xA;        // Si une autre valeur existe, on la conserve&#xA;        // ----------------------------------------------------&#xA;&#xA;        else {&#xA;&#xA;            statutNormalise = statut;&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;&#xA;// ============================================================&#xA;// 3. PREPARATION DES CHAMPS TEXTE POUR LE JSON&#xA;// ============================================================&#xA;&#xA;String clientId =&#xA;    row1.client_id != null&#xA;        ? row1.client_id&#xA;        : &quot;&quot;;&#xA;&#xA;String nomPrenom =&#xA;    row1.nom_prenom != null&#xA;        ? row1.nom_prenom&#xA;        : &quot;&quot;;&#xA;&#xA;String dateNaissance =&#xA;    row1.date_naissance != null&#xA;        ? row1.date_naissance&#xA;        : &quot;&quot;;&#xA;&#xA;String email =&#xA;    row1.email != null&#xA;        ? row1.email&#xA;        : &quot;&quot;;&#xA;&#xA;String adresse =&#xA;    row1.adresse != null&#xA;        ? row1.adresse&#xA;        : &quot;&quot;;&#xA;&#xA;String codePostal =&#xA;    row1.code_postal != null&#xA;        ? row1.code_postal&#xA;        : &quot;&quot;;&#xA;&#xA;String numFiscal =&#xA;    row1.num_fiscal != null&#xA;        ? row1.num_fiscal&#xA;        : &quot;&quot;;&#xA;&#xA;String dateCreation =&#xA;    row1.date_creation != null&#xA;        ? row1.date_creation&#xA;        : &quot;&quot;;&#xA;&#xA;&#xA;// ============================================================&#xA;// 4. ECHAPPEMENT DES CARACTERES POUR LE JSON&#xA;// ============================================================&#xA;&#xA;clientId = clientId&#xA;    .replace(&quot;\\&quot;, &quot;\\\\&quot;)&#xA;    .replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;)&#xA;    .replace(&quot;\r&quot;, &quot;\\r&quot;)&#xA;    .replace(&quot;\n&quot;, &quot;\\n&quot;);&#xA;&#xA;nomPrenom = nomPrenom&#xA;    .replace(&quot;\\&quot;, &quot;\\\\&quot;)&#xA;    .replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;)&#xA;    .replace(&quot;\r&quot;, &quot;\\r&quot;)&#xA;    .replace(&quot;\n&quot;, &quot;\\n&quot;);&#xA;&#xA;dateNaissance = dateNaissance&#xA;    .replace(&quot;\\&quot;, &quot;\\\\&quot;)&#xA;    .replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;)&#xA;    .replace(&quot;\r&quot;, &quot;\\r&quot;)&#xA;    .replace(&quot;\n&quot;, &quot;\\n&quot;);&#xA;&#xA;email = email&#xA;    .replace(&quot;\\&quot;, &quot;\\\\&quot;)&#xA;    .replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;)&#xA;    .replace(&quot;\r&quot;, &quot;\\r&quot;)&#xA;    .replace(&quot;\n&quot;, &quot;\\n&quot;);&#xA;&#xA;adresse = adresse&#xA;    .replace(&quot;\\&quot;, &quot;\\\\&quot;)&#xA;    .replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;)&#xA;    .replace(&quot;\r&quot;, &quot;\\r&quot;)&#xA;    .replace(&quot;\n&quot;, &quot;\\n&quot;);&#xA;&#xA;codePostal = codePostal&#xA;    .replace(&quot;\\&quot;, &quot;\\\\&quot;)&#xA;    .replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;)&#xA;    .replace(&quot;\r&quot;, &quot;\\r&quot;)&#xA;    .replace(&quot;\n&quot;, &quot;\\n&quot;);&#xA;&#xA;numFiscal = numFiscal&#xA;    .replace(&quot;\\&quot;, &quot;\\\\&quot;)&#xA;    .replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;)&#xA;    .replace(&quot;\r&quot;, &quot;\\r&quot;)&#xA;    .replace(&quot;\n&quot;, &quot;\\n&quot;);&#xA;&#xA;dateCreation = dateCreation&#xA;    .replace(&quot;\\&quot;, &quot;\\\\&quot;)&#xA;    .replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;)&#xA;    .replace(&quot;\r&quot;, &quot;\\r&quot;)&#xA;    .replace(&quot;\n&quot;, &quot;\\n&quot;);&#xA;&#xA;&#xA;// ============================================================&#xA;// 5. PREPARATION DU TELEPHONE POUR LE JSON&#xA;// ============================================================&#xA;&#xA;String telephoneJson;&#xA;&#xA;if (telephoneNormalise == null) {&#xA;&#xA;    telephoneJson = &quot;null&quot;;&#xA;&#xA;} else {&#xA;&#xA;    telephoneJson =&#xA;        &quot;\&quot;&quot;&#xA;        + telephoneNormalise&#xA;            .replace(&quot;\\&quot;, &quot;\\\\&quot;)&#xA;            .replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;)&#xA;        + &quot;\&quot;&quot;;&#xA;}&#xA;&#xA;&#xA;// ============================================================&#xA;// 6. PREPARATION DU STATUT POUR LE JSON&#xA;// ============================================================&#xA;&#xA;String statutJson;&#xA;&#xA;if (statutNormalise == null) {&#xA;&#xA;    statutJson = &quot;null&quot;;&#xA;&#xA;} else {&#xA;&#xA;    statutJson =&#xA;        &quot;\&quot;&quot;&#xA;        + statutNormalise&#xA;            .replace(&quot;\\&quot;, &quot;\\\\&quot;)&#xA;            .replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;)&#xA;        + &quot;\&quot;&quot;;&#xA;}&#xA;&#xA;&#xA;// ============================================================&#xA;// 7. LOYALTY SCORE&#xA;// ============================================================&#xA;&#xA;String loyaltyScoreJson;&#xA;&#xA;if (row1.loyalty_score == null) {&#xA;&#xA;    loyaltyScoreJson = &quot;null&quot;;&#xA;&#xA;} else {&#xA;&#xA;    // loyalty_score est un INT&#xA;    loyaltyScoreJson = String.valueOf(row1.loyalty_score);&#xA;}&#xA;&#xA;// ============================================================&#xA;// 8. CONSTRUCTION DU JSON&#xA;// ============================================================&#xA;&#xA;String messageJson =&#xA;    &quot;{&quot;&#xA;    + &quot;\&quot;client_id\&quot;:\&quot;&quot; + clientId + &quot;\&quot;,&quot;&#xA;    + &quot;\&quot;nom_prenom\&quot;:\&quot;&quot; + nomPrenom + &quot;\&quot;,&quot;&#xA;    + &quot;\&quot;date_naissance\&quot;:\&quot;&quot; + dateNaissance + &quot;\&quot;,&quot;&#xA;    + &quot;\&quot;email\&quot;:\&quot;&quot; + email + &quot;\&quot;,&quot;&#xA;    + &quot;\&quot;telephone\&quot;:&quot; + telephoneJson + &quot;,&quot;&#xA;    + &quot;\&quot;adresse\&quot;:\&quot;&quot; + adresse + &quot;\&quot;,&quot;&#xA;    + &quot;\&quot;code_postal\&quot;:\&quot;&quot; + codePostal + &quot;\&quot;,&quot;&#xA;    + &quot;\&quot;num_fiscal\&quot;:\&quot;&quot; + numFiscal + &quot;\&quot;,&quot;&#xA;    + &quot;\&quot;date_creation\&quot;:\&quot;&quot; + dateCreation + &quot;\&quot;,&quot;&#xA;    + &quot;\&quot;statut_client\&quot;:&quot; + statutJson + &quot;,&quot;&#xA;    + &quot;\&quot;loyalty_score\&quot;:&quot; + loyaltyScoreJson&#xA;    + &quot;}&quot;;&#xA;&#xA;&#xA;// ============================================================&#xA;// 9. CREATION DU MESSAGE KAFKA&#xA;// ============================================================&#xA;&#xA;org.apache.kafka.clients.producer.ProducerRecord&lt;String, String> recordKafka =&#xA;    new org.apache.kafka.clients.producer.ProducerRecord&lt;>(&#xA;        &quot;abassurance.clients.v1&quot;,&#xA;        String.valueOf(row1.client_id),&#xA;        messageJson&#xA;    );&#xA;&#xA;&#xA;// ============================================================&#xA;// 10. ENVOI KAFKA&#xA;// ============================================================&#xA;&#xA;// Pas de lambda ici : évite l'erreur &quot;row1 defined in an&#xA;// enclosing scope must be final or effectively final&quot;.&#xA;&#xA;compteurEnvoisTentes.incrementAndGet();&#xA;&#xA;try {&#xA;&#xA;    kafkaProducer.send(recordKafka).get();&#xA;&#xA;    compteurEnvoisReussis.incrementAndGet();&#xA;&#xA;} catch (Exception e) {&#xA;&#xA;    compteurEnvoisEchoues.incrementAndGet();&#xA;&#xA;    System.err.println(&#xA;        &quot;Erreur Kafka pour le client &quot;&#xA;        + row1.client_id&#xA;        + &quot; : &quot;&#xA;        + e.getMessage()&#xA;    );&#xA;}&#xA;&#xA;&#xA;// ============================================================&#xA;// 11. FAIRE SUIVRE LA LIGNE&#xA;// ============================================================&#xA;&#xA;row2.client_id = row1.client_id;&#xA;&#xA;row2.nom_prenom = row1.nom_prenom;&#xA;&#xA;row2.date_naissance = row1.date_naissance;&#xA;&#xA;row2.email = row1.email;&#xA;&#xA;// Téléphone NORMALISE&#xA;row2.telephone = telephoneNormalise;&#xA;&#xA;row2.adresse = row1.adresse;&#xA;&#xA;row2.code_postal = row1.code_postal;&#xA;&#xA;row2.num_fiscal = row1.num_fiscal;&#xA;&#xA;row2.date_creation = row1.date_creation;&#xA;&#xA;// Statut NORMALISE&#xA;row2.statut_client = statutNormalise;&#xA;&#xA;row2.loyalty_score = row1.loyalty_score;&#xA;&#xA;&#xA;// ============================================================&#xA;// 12. AFFICHAGE&#xA;// ============================================================&#xA;&#xA;System.out.println(&#xA;    &quot;Client envoyé : &quot;&#xA;    + row1.client_id&#xA;    + &quot; | Téléphone : &quot;&#xA;    + telephoneNormalise&#xA;    + &quot; | Statut : &quot;&#xA;    + statutNormalise&#xA;);"/>
    <elementParameter field="MEMO_JAVA" name="CODE_END" value="// ============================================================&#xA;// FIN DU JOB&#xA;// ============================================================&#xA;&#xA;kafkaProducer.flush();&#xA;&#xA;kafkaProducer.close();&#xA;&#xA;&#xA;// ============================================================&#xA;// ENREGISTREMENT DES COMPTEURS&#xA;// ============================================================&#xA;&#xA;globalMap.put(&#xA;    &quot;kafka_envois_tentes&quot;,&#xA;    compteurEnvoisTentes.get()&#xA;);&#xA;&#xA;globalMap.put(&#xA;    &quot;kafka_envois_reussis&quot;,&#xA;    compteurEnvoisReussis.get()&#xA;);&#xA;&#xA;globalMap.put(&#xA;    &quot;kafka_envois_echoues&quot;,&#xA;    compteurEnvoisEchoues.get()&#xA;);&#xA;&#xA;&#xA;// ============================================================&#xA;// AFFICHAGE DU BILAN&#xA;// ============================================================&#xA;&#xA;System.out.println(&#xA;    &quot;==============================================&quot;&#xA;);&#xA;&#xA;System.out.println(&#xA;    &quot;Kafka CLIENTS - BILAN&quot;&#xA;);&#xA;&#xA;System.out.println(&#xA;    &quot;Tentes  : &quot;&#xA;    + compteurEnvoisTentes.get()&#xA;);&#xA;&#xA;System.out.println(&#xA;    &quot;Réussis : &quot;&#xA;    + compteurEnvoisReussis.get()&#xA;);&#xA;&#xA;System.out.println(&#xA;    &quot;Échoués : &quot;&#xA;    + compteurEnvoisEchoues.get()&#xA;);&#xA;&#xA;System.out.println(&#xA;    &quot;==============================================&quot;&#xA;);"/>
    <elementParameter field="CHECK" name="Version_V2_0" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V3_2" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V4.0" value="true" show="false"/>

  <node componentName="tJavaFlex" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="288" posY="128">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaFlex_1" show="false"/>
    <elementParameter field="CHECK" name="DATA_AUTO_PROPAGATE" value="true"/>
    <elementParameter field="MEMO_JAVA" name="CODE_START" value="java.util.Properties kafkaProps = new java.util.Properties();&#xA;kafkaProps.put(org.apache.kafka.clients.producer.ProducerConfig.BOOTSTRAP_SERVERS_CONFIG, &quot;localhost:9092&quot;);&#xA;kafkaProps.put(org.apache.kafka.clients.producer.ProducerConfig.KEY_SERIALIZER_CLASS_CONFIG, &quot;org.apache.kafka.common.serialization.StringSerializer&quot;);&#xA;kafkaProps.put(org.apache.kafka.clients.producer.ProducerConfig.VALUE_SERIALIZER_CLASS_CONFIG, &quot;org.apache.kafka.common.serialization.StringSerializer&quot;);&#xA;&#xA;org.apache.kafka.clients.producer.KafkaProducer&lt;String, String> kafkaProducer =&#xA;    new org.apache.kafka.clients.producer.KafkaProducer&lt;>(kafkaProps);&#xA;&#xA;java.util.concurrent.atomic.AtomicInteger compteurEnvoisTentes = new java.util.concurrent.atomic.AtomicInteger(0);&#xA;java.util.concurrent.atomic.AtomicInteger compteurEnvoisReussis = new java.util.concurrent.atomic.AtomicInteger(0);&#xA;java.util.concurrent.atomic.AtomicInteger compteurEnvoisEchoues = new java.util.concurrent.atomic.AtomicInteger(0);&#xA;&#xA;// Lambda d'échappement JSON (une méthode ne peut pas être déclarée ici,&#xA;// donc on la stocke dans une variable, comme pour le job contrat)&#xA;java.util.function.Function&lt;String, String> echapperJson = (valeur) -> {&#xA;    if (valeur == null) return &quot;&quot;;&#xA;    return valeur.replace(&quot;\\&quot;, &quot;\\\\&quot;)&#xA;                 .replace(&quot;\&quot;&quot;, &quot;\\\&quot;&quot;)&#xA;                 .replace(&quot;\n&quot;, &quot;\\n&quot;)&#xA;                 .replace(&quot;\r&quot;, &quot;\\r&quot;);&#xA;};"/>
    <elementParameter field="MEMO_JAVA" name="CODE_MAIN" value="String messageJson = &quot;{&quot;&#xA;    + &quot;\&quot;paiement_id\&quot;:\&quot;&quot; + echapperJson.apply(row1.paiement_id) + &quot;\&quot;,&quot;&#xA;    + &quot;\&quot;contrat_id\&quot;:\&quot;&quot; + echapperJson.apply(row1.contrat_id) + &quot;\&quot;,&quot;&#xA;    + &quot;\&quot;date_paiement\&quot;:\&quot;&quot; + echapperJson.apply(row1.date_paiement) + &quot;\&quot;,&quot;&#xA;    + &quot;\&quot;montant\&quot;:&quot; + row1.montant + &quot;,&quot;&#xA;    + &quot;\&quot;mode_paiement\&quot;:\&quot;&quot; + echapperJson.apply(row1.mode_paiement) + &quot;\&quot;,&quot;&#xA;    + &quot;\&quot;statut_transaction\&quot;:\&quot;&quot; + echapperJson.apply(row1.statut_transaction) + &quot;\&quot;&quot;&#xA;    + &quot;}&quot;;&#xA;&#xA;// Clé Kafka = paiement_id converti en String, pour respecter le&#xA;// StringSerializer configuré (paiement_id est un Integer dans le schéma)&#xA;&#xA;&#xA;org.apache.kafka.clients.producer.ProducerRecord&lt;String, String> recordKafka =&#xA;    new org.apache.kafka.clients.producer.ProducerRecord&lt;>(&quot;abassurance.paiements.v1&quot;, row1.paiement_id, messageJson);&#xA;&#xA;compteurEnvoisTentes.incrementAndGet();&#xA;&#xA;final String paiementIdPourLog = row1.paiement_id;&#xA;&#xA;kafkaProducer.send(recordKafka, (metadata, exception) -> {&#xA;    if (exception == null) {&#xA;        compteurEnvoisReussis.incrementAndGet();&#xA;    } else {&#xA;        compteurEnvoisEchoues.incrementAndGet();&#xA;        System.err.println(&quot;Echec envoi Kafka pour paiement &quot; + paiementIdPourLog + &quot; : &quot; + exception.getMessage());&#xA;    }&#xA;});&#xA;&#xA;row2.paiement_id = row1.paiement_id;&#xA;row2.contrat_id = row1.contrat_id;&#xA;row2.date_paiement = row1.date_paiement;&#xA;row2.montant = row1.montant;&#xA;row2.mode_paiement = row1.mode_paiement;&#xA;row2.statut_transaction = row1.statut_transaction;"/>
    <elementParameter field="MEMO_JAVA" name="CODE_END" value="// flush() attend que TOUS les envois en attente soient partis avant de continuer&#xA;// (sinon avec close() direct, tu risques de perdre les derniers messages en vol)&#xA;kafkaProducer.flush();&#xA;kafkaProducer.close();&#xA;&#xA;globalMap.put(&quot;kafka_envois_tentes&quot;, compteurEnvoisTentes.get());&#xA;globalMap.put(&quot;kafka_envois_reussis&quot;, compteurEnvoisReussis.get());&#xA;globalMap.put(&quot;kafka_envois_echoues&quot;, compteurEnvoisEchoues.get());&#xA;&#xA;System.out.println(&quot;Kafka - Tentes: &quot; + compteurEnvoisTentes.get()&#xA;    + &quot; | Reussis: &quot; + compteurEnvoisReussis.get()&#xA;    + &quot; | Echoues: &quot; + compteurEnvoisEchoues.get());"/>
    <elementParameter field="CHECK" name="Version_V2_0" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V3_2" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V4.0" value="true" show="false"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaFlex_1">
      <column comment="" key="true" length="-1" name="paiement_id" nullable="false" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="contrat_id" nullable="false" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="date_paiement" nullable="false" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="-1" name="montant" nullable="false" pattern="" precision="-1" sourceType="" type="id_Float" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="mode_paiement" nullable="false" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="statut_transaction" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
    </metadata>
  </node>
  <node componentName="tFileOutputDelimited" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="416" posY="128">
